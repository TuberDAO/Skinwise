'use client'

import { useState, useEffect } from 'react'
import { useRouter } from 'next/navigation'
import { Button } from "@/components/ui/button"
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card"
import { useAuth } from '@/components/providers/auth-provider'
import { CheckCircle, Clock, Calendar, Home, ArrowRight } from "lucide-react"
import Link from "next/link"

export default function SuccessPage() {
  const router = useRouter()
  const [sessionId, setSessionId] = useState<string | null>(null)
  const [authState, setAuthState] = useState<{user: any, loading: boolean}>({ user: null, loading: true })

  // Safe way to get search params
  useEffect(() => {
    if (typeof window !== 'undefined') {
      const urlParams = new URLSearchParams(window.location.search)
      const sessionIdFromUrl = urlParams.get('session_id')
      console.log('Success page loaded with session ID:', sessionIdFromUrl)
      setSessionId(sessionIdFromUrl)
    }
  }, [])

  // Safe auth loading
  useEffect(() => {
    try {
      const { useAuth } = require('@/components/providers/auth-provider')
      const { user, loading } = useAuth()
      setAuthState({ user, loading })
    } catch (error) {
      console.warn('Auth provider not available, redirecting to login:', error)
      if (typeof window !== 'undefined') {
        window.location.href = '/login'
      }
    }
  }, [])

  useEffect(() => {
    // Clear pending assessment from session storage
    if (typeof window !== 'undefined') {
      sessionStorage.removeItem('pendingAssessment')
    }
  }, [sessionId])

  // Show loading if auth is still loading
  if (authState.loading) {
    return (
      <div className="min-h-screen flex items-center justify-center">
        <div className="text-center">
          <div className="w-8 h-8 border-2 border-brand-blue border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
          <p>Loading...</p>
        </div>
      </div>
    )
  }

  return (
    <div className="min-h-screen flex flex-col bg-gradient-to-br from-slate-50 to-teal-50">
      {/* Header */}
      <header className="px-4 lg:px-6 h-14 flex items-center border-b bg-white/80 backdrop-blur-sm">
        <Link className="flex items-center justify-center" href="/">
          <img 
            src="/skinwise-logo.png.png" 
            alt="SkinWise App" 
            className="h-10 w-auto"
          />
        </Link>
        <div className="ml-auto text-sm text-slate-600">
          {authState.user?.email || 'User'}
        </div>
      </header>

      {/* Main Content */}
      <div className="flex-1 flex items-center justify-center p-4">
        <div className="max-w-2xl w-full space-y-8">
          
          {/* Success Icon & Title */}
          <div className="text-center space-y-6">
            <div className="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto shadow-lg">
              <CheckCircle className="w-10 h-10 text-green-600" />
            </div>
            <div className="space-y-2">
              <h1 className="text-3xl font-bold text-slate-900">
                Payment Successful!
              </h1>
              <p className="text-lg text-slate-600">
                Thank you for submitting your skin assessment.
              </p>
            </div>
          </div>

          {/* Main Message Card */}
          <Card className="shadow-lg border-0 bg-white/80 backdrop-blur-sm">
            <CardHeader className="text-center pb-4">
              <CardTitle className="text-xl text-slate-900">Assessment Confirmed</CardTitle>
              <CardDescription className="text-base">
                Your submission has been received and is being processed
              </CardDescription>
            </CardHeader>
            <CardContent className="space-y-6">
              
              {/* Timeline Message */}
              <div className="bg-blue-50 border border-blue-200 rounded-lg p-4">
                <div className="flex items-start space-x-3">
                  <Clock className="w-5 h-5 text-blue-600 mt-0.5" />
                  <div>
                    <h3 className="font-semibold text-blue-900 mb-1">What's Next</h3>
                    <p className="text-blue-800">
                      <strong>You'll receive your AI-assisted report and dermatologist referral within 24 hours or less.</strong>
                    </p>
                  </div>
                </div>
              </div>

              {/* Optional Message */}
              <div className="bg-teal-50 border border-teal-200 rounded-lg p-4">
                <div className="flex items-start space-x-3">
                  <Calendar className="w-5 h-5 text-teal-600 mt-0.5" />
                  <div>
                    <h3 className="font-semibold text-teal-900 mb-1">Your Choice</h3>
                    <p className="text-teal-800">
                      You can schedule an online dermatologist appointment immediately, or wait until after you receive your report.
                    </p>
                  </div>
                </div>
              </div>

              {/* Email Confirmation */}
              <div className="text-center py-2">
                <p className="text-sm text-slate-600">
                  We'll send all updates to <strong>{authState.user?.email}</strong>
                </p>
              </div>

              {/* Action Buttons */}
              <div className="flex flex-col sm:flex-row gap-3 pt-4">
                <Link href="/" className="flex-1">
                  <Button 
                    variant="outline" 
                    className="w-full h-12 text-base font-medium border-slate-300 hover:bg-slate-50"
                  >
                    <Home className="w-4 h-4 mr-2" />
                    Return to Home
                  </Button>
                </Link>
                
                <Button 
                  onClick={() => {
                    // Placeholder for appointment scheduling
                    // This could open a booking widget or redirect to a scheduling page
                    console.log('Schedule appointment clicked')
                    // For now, just show an alert
                    alert('Appointment scheduling feature coming soon! You can wait for your report or contact us directly.')
                  }}
                  className="flex-1 h-12 text-base font-medium bg-brand-blue hover:bg-brand-blue/90"
                >
                  <Calendar className="w-4 h-4 mr-2" />
                  Schedule Appointment
                  <ArrowRight className="w-4 h-4 ml-2" />
                </Button>
              </div>

              {/* Additional Info */}
              <div className="text-center pt-4 border-t">
                <p className="text-xs text-slate-500">
                  Questions? Contact us at support@skinwise.com
                </p>
              </div>

            </CardContent>
          </Card>

          {/* What to Expect Section */}
          <Card className="shadow-lg border-0 bg-white/60 backdrop-blur-sm">
            <CardHeader>
              <CardTitle className="text-lg text-slate-900">What to Expect</CardTitle>
            </CardHeader>
            <CardContent className="space-y-4">
              <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div className="text-center space-y-2">
                  <div className="w-12 h-12 bg-brand-blue text-white rounded-full flex items-center justify-center mx-auto font-bold">
                    1
                  </div>
                  <h4 className="font-medium text-slate-900">AI Analysis</h4>
                  <p className="text-sm text-slate-600">
                    Advanced AI reviews your photos and symptoms
                  </p>
                </div>
                
                <div className="text-center space-y-2">
                  <div className="w-12 h-12 bg-brand-blue text-white rounded-full flex items-center justify-center mx-auto font-bold">
                    2
                  </div>
                  <h4 className="font-medium text-slate-900">Professional Review</h4>
                  <p className="text-sm text-slate-600">
                    Expert validation and personalized recommendations
                  </p>
                </div>
                
                <div className="text-center space-y-2">
                  <div className="w-12 h-12 bg-brand-blue text-white rounded-full flex items-center justify-center mx-auto font-bold">
                    3
                  </div>
                  <h4 className="font-medium text-slate-900">Your Report</h4>
                  <p className="text-sm text-slate-600">
                    Detailed analysis with next steps delivered to your email
                  </p>
                </div>
              </div>
            </CardContent>
          </Card>

        </div>
      </div>
    </div>
  )
} 